      "next": "line_q3b1"
    },
    "line_q3b1": {
      "type": "line",
      "speaker": "lillian",
      "text": "자, 그럼 정리해보자면...",
      "next": "line_ingredient_reveal"
    },
    "line_q3c": {
      "type": "line",
      "speaker": "chaeon",
      "text": "저는 파란색을 좋아해요.",
      "next": "line_q3c1"
