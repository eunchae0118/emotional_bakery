    },
    "line_q2a3": {
      "type": "line",
      "speaker": "chaeon",
      "text": "지뢰 찾기 같은 거...",
      "next": "line_q2a4"
    },
    "line_q2a4": {
      "type": "line",
      "speaker": "lillian",
      "text": "...아?...",
      "expression": "assets/images/lillian_surprise.png",
