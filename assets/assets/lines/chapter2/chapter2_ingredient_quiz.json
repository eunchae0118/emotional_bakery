{
  "dialogue_id": "chapter2_ingredient_quiz",
  "start": "line_q1_intro",
  "nodes": {
    "line_q1_intro": {
      "type": "line",
      "speaker": "lillian",
      "text": "...크흠! 그~러면",
      "next": "line_q.1"
    },
    "line_q.1": {
      "type": "line",
      "speaker": "lillian",
      "text": "평소 좋아하는 건 뭐에요~?",
      "next": "choice_q1"
    },
    "choice_q1": {
      "type": "choice",
      "options": [
        { "text": "먹기", "next": "line_q1a", "setVars": { "q1": "eat" } },
        { "text": "잠자기", "next": "line_q1b", "setVars": { "q1": "sleep" } },
        { "text": "놀기", "next": "line_q1c", "setVars": { "q1": "play" } }
      ]
    },
    "line_q1a": {
      "type": "line",
      "speaker": "chaeon",
      "text": "저는 먹는 걸 좋아해요.",
      "next": "line_q1a1"
    },
    "line_q1a1": {
      "type": "line",
      "speaker": "lillian",
      "text": "저도요! 맛있는 걸 먹으면 괜히 기분이 좋아지잖아요.",
      "next": "line_q1a2"
    },
    "line_q1a2": {
      "type": "line",
      "speaker": "lillian",
      "text": "제빵사도 그래서 한 거예요! 빵을 잔뜩 먹고 싶어서요~",
      "expression": "assets/images/lillian_happy.png",
      "next": "line_q2_intro"
    },
    "line_q1b": {
      "type": "line",
      "speaker": "chaeon",
      "text": "저는 자는 걸 좋아해요...",
      "next": "line_q1b1"
    },
    "line_q1b1": {
      "type": "line",
      "speaker": "chaeon",
      "text": "아무런 생각 없이 푹 잘 수 있을 때가 제일 좋아요.",
      "next": "line_q1b2"
    },
    "line_q1b2": {
      "type": "line",
      "speaker": "lillian",
      "text": "푹 자면 너무 좋죠!",
      "expression": "assets/images/lillian_happy.png",
      "next": "line_q1b3"
    },
    "line_q1b3": {
      "type": "line",
      "speaker": "lillian",
      "text": "저도 쉬는 날엔 하루 종일 자기도 하거든요!",
      "next": "line_q2_intro"
    },
    "line_q1c": {
      "type": "line",
      "speaker": "chaeon",
      "text": "저는 노는 걸 좋아해요. 혼자 노는 거요.",
      "next": "line_q1c1"
    },
    "line_q1c1": {
      "type": "line",
      "speaker": "lillian",
      "text": "어떻게 놀아요?",
      "next": "line_q1c2"
    },
    "line_q1c2": {
      "type": "line",
      "speaker": "chaeon",
      "text": "뭐 책도 보고... 참새랑 대화도 하고...",
      "next": "line_q1c3"
    },
    "line_q1c3": {
      "type": "line",
      "speaker": "lillian",
      "text": "아~ 참새랑 대화! \"짹짹\"이라고 하시나요?",
      "expression": "assets/images/lillian_happy.png",
      "next": "line_q1c3c"
    },
    "line_q1c3c": {
      "type": "line",
      "speaker": "chaeon",
      "text": "..................?",
      "next": "line_q2_intro"
    },
    "line_q2_intro": {
      "type": "line",
      "speaker": "lillian",
      "text": "좋아요! 그럼 쉴 때 주로 하는 취미는 뭐예요?",
      "next": "choice_q2"
    },
    "choice_q2": {
      "type": "choice",
