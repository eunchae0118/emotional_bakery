    "line_019": {
      "type": "line",
      "speaker": "lillian",
      "text": "그날들이 마음 안에서 없어지는 건 아니에요.",
      "next": "line_020"
    },
    "line_020": {
      "type": "line",
      "speaker": "lillian",
      "text": "빵에 담기는 건 기억이 아니라, 그때의 감정이니까요.",
      "next": "line_021"
    },
    "line_021": {
      "type": "line",
      "speaker": "chaeon",
      "text": "...그래도 물건이 없어지는 건 맞잖아요...",
      "next": "line_022"
    },
    "line_022": {
      "type": "line",
      "speaker": "lillian",
      "text": "...!",
      "expression": "assets/images/lillian_surprise.png",
      "next": "line_023"
    },
    "line_023": {
      "type": "line",
      "speaker": "lillian",
      "text": "그건... 그렇긴 하지만...",
      "expression": "assets/images/lillian_thinking1.png",
      "next": "line_024"
    },
    "line_024": {
      "type": "line",
      "speaker": "lillian",
      "text": "그래도 채온님 마음속에 살아있을 거예요...!",
      "next": "line_025"
    },
    "line_025": {
      "type": "line",
      "speaker": "chaeon",
      "text": "오글거려요...",
      "next": "line_026"
    },
    "line_026": {
      "type": "line",
      "speaker": "lillian",
      "text": "네...",
