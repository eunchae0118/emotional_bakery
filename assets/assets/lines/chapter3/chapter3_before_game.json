      "next": "line_002c9"
    },
    "line_002a9": {
      "type": "line",
      "speaker": "lillian",
      "text": "...힘든 건 알지만...",
      "expression": "assets/images/lillian_thinking2.png",
      "next": "line_002a10"
    },
    "line_002b9": {
      "type": "line",
      "speaker": "lillian",
      "text": "지금은 없는 물건인가요?",
