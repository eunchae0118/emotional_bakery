    "line_002c9": {
      "type": "line",
      "speaker": "chaeon",
      "text": "그런 건가요...",
      "next": "line_002c10"
    },
    "line_002a10": {
      "type": "line",
      "speaker": "lillian",
      "text": "감정을 되찾기 위해서는 정말",
