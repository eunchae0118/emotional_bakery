    "line_011": {
      "type": "line",
      "speaker": "chaeon",
      "text": "이건... 잘 모르겠어요.",
      "next": "line_012"
    },
    "line_012": {
      "type": "line",
      "speaker": "lillian",
      "text": "억지로 하지 않아도 돼요.",
      "next": "line_013"
    },
    "line_013": {
      "type": "line",
      "speaker": "lillian",
      "text": "준비가 됐을 때 해도 되고, 안 해도 되고요.",
